{
  "name": "@senad-d/pi-k8s-knowledge",
  "version": "0.1.0",
  "description": "Official Kubernetes documentation evidence and citations for Pi, without cluster access",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "license": "MIT",
  "author": "Senad Dizdarević <112484166+senad-d@users.noreply.github.com>",
  "homepage": "https://github.com/senad-d/pi-k8s-knowledge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senad-d/pi-k8s-knowledge.git"
  },
  "bugs": {
    "url": "https://github.com/senad-d/pi-k8s-knowledge/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "cli",
    "terminal",
    "typescript",
    "coding-agent",
    "kubernetes",
    "k8s",
    "documentation",
    "retrieval",
    "citations"
  ],
  "files": [
    "src/index.ts",
    "src/retrieval.ts",
    "src/evidence.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/senad-d/pi-k8s-knowledge/main/assets/preview.png"
  },
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "coverage": "c8 --all --include='src/**/*.ts' --reporter=text --reporter=lcov --check-coverage --per-file --lines=81 --statements=81 --functions=81 --branches=81 node --import tsx --test test/*.test.ts",
    "test:coverage": "npm run coverage",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint": "npm run typecheck && npm run lint:eslint",
    "check": "npm run lint && npm run test:coverage",
    "pack:dry-run": "npm pack --dry-run --json --ignore-scripts",
    "check:pack": "node --import tsx --test test/package.test.ts",
    "validate": "npm run check",
    "prepublishOnly": "npm run validate"
  },
  "dependencies": {
    "parse5": "8.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.25",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
